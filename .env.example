# Copy to .env. Leave the key blank to read the included sample without generation.
GEMINI_API_KEY=
# These match the hosted source defaults; change if your Gemini project uses other model IDs.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Local browser port (container still listens on 3000).
SHIQU_PORT=3000
