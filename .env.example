# Interactive CLI/desktop setup saves provider settings in the shared private database.
# CLI does not auto-load .env; use --config /path/to/file for invocation-only overrides.
# Source development reads .env. Provider: gemini / codex / openai / readonly.
SHIQU_AI_PROVIDER=gemini
# OpenAI API uses API billing, independently of Codex subscriptions.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Codex mode needs no Gemini/OpenAI API key. Use Sol for theme matching and story planning.
CODEX_BIN=codex
CODEX_MODEL=gpt-6.1-sol
# Fallback for unclassified Codex requests, including the image-tool invocation; blank inherits CLI defaults.
# Text tasks use their own settings below. This is not an image-quality setting.
CODEX_REASONING_EFFORT=low
# Text-task budgets (both providers). Codex: low/medium/high/xhigh/max; Gemini: low/medium/high.
SHIQU_REASONING_SUGGEST=medium
SHIQU_REASONING_ART=low
SHIQU_REASONING_FRAMES=medium
SHIQU_REASONING_OUTLINE=high
SHIQU_REASONING_PLAN=high
SHIQU_REASONING_REVIEW=high
SHIQU_REASONING_REPAIR=high
# Optional dedicated Codex login directory; blank reuses the CLI default.
SHIQU_CODEX_HOME=
# Gemini API key. First use has an empty shelf; readonly needs no API credentials.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Docker browser port; the container listens on 3000.
SHIQU_PORT=3000
# Host folder mounted at /data; create it before starting Docker.
SHIQU_HOST_DATA_DIR=./data
# Linux: set these to id -u / id -g so files belong to your host user.
SHIQU_UID=1000
SHIQU_GID=1000

# Global queued image concurrency (1-8); text and local publication use separate pools.
SHIQU_IMAGE_WORKERS=3

# Invocation-only story-library override; CLI/development otherwise follow shared saved dataDirectory.
# macOS default: ~/Library/Application Support/com.shiqu.desktop/library
# SHIQU_DATA_DIR="/absolute/path/to/shared-library"
