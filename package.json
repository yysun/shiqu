{
  "name": "shiqu-docker",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs && pnpm install --frozen-lockfile",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:runtime": "docker build --target runtime --tag shiqu:local .",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "import:legacy": "node dist/server/import-legacy.js",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "codex:login": "node --env-file-if-exists=.env scripts/codex-login.mjs login",
    "codex:status": "node --env-file-if-exists=.env scripts/codex-login.mjs status",
    "library:prepare": "node --env-file-if-exists=.env --experimental-strip-types scripts/prepare-reading-blocks.mjs",
    "desktop:prepare": "pnpm build && pnpm exec vite build --config desktop/vite.config.ts && node scripts/desktop-resources.mjs && node scripts/desktop-node.mjs",
    "desktop:prepare:lite": "pnpm build && pnpm exec vite build --config desktop/vite.config.ts && node scripts/desktop-resources.mjs --lite",
    "desktop:dev": "pnpm exec tauri dev",
    "desktop:preview": "vite --config desktop/vite.config.ts",
    "desktop:build": "pnpm exec tauri build",
    "desktop:build:lite": "pnpm exec tauri build --config src-tauri/tauri.lite.conf.json",
    "desktop:dev:lite": "pnpm exec tauri dev --config src-tauri/tauri.lite.conf.json",
    "desktop:test": "cd src-tauri && cargo test --locked --features bundled-node",
    "desktop:test:lite": "cd src-tauri && cargo test --locked",
    "desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@tauri-apps/api": "2.12.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.8.2",
    "htmlparser2": "10.0.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "opencc-js": "1.0.5",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tiktoken": "1.0.22",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}