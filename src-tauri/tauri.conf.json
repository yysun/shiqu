{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shiqu",
  "version": "0.4.1",
  "identifier": "com.shiqu.desktop",
  "build": {
    "beforeDevCommand": "pnpm run desktop:prepare",
    "beforeBuildCommand": "pnpm run desktop:prepare",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "\u62fe\u8da3",
        "width": 1040,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../desktop/resources/runtime/": "runtime/",
      "../desktop/resources/node/": "node/",
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE"
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
